# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class


# Installer logs
pip-log.txt
pip-delete-this-directory.txt


# Django stuff:
*.log
local_settings.py
*.sqlite3
db.sqlite3-journal

# pyenv
.python-version

# PEP 582; used by e.g. github.com/David-OConnor/pyflow
__pypackages__/

# Environments
.env
.venv
prod.env
env/
venv/
ENV/
env.bak/
venv.bak/
fixture/
*/fixtures/*
.idea/

# workspace files are user-specific
.vscode


media/
old_files/
note_old_files/
project_old_files/
migrate_files_exit.json
project_migrate_files_exit.json
note_migrate_files_exit.json
/source/fixtures/

staticfiles/

# RStudio session artifacts
.Rproj.user
.RData
.Rhistory

# Generated archives
research/r_queries.zip

# Descargas del INEGI que download_inegi.sh regenera (Marco Geoestadístico
# y catálogo de localidades AGEEML): pesan mucho y son reproducibles
space_time/geo_files/00ent.*
space_time/geo_files/00mun.*
space_time/geo_files/00l.*
space_time/geo_files/localidades.csv
space_time/geo_files/localidades.txt

# Catálogo AGEEML de municipios: el .csv sí se versiona, el .txt no
# (mismo contenido, y ningún loader lo lee)
space_time/geo_files/municipios.txt

# credenciales de colaboradoras (usar config.R.template)
research/r_queries/config.R

# Respaldos de geolocate_locations --fill (los consume --revert)
.claude/geolocate_fill_*.json

# Salidas de los diagnósticos de geolocalización (se regeneran desde la base)
.claude/geolocate_review*.csv
.claude/geolocate_review*.jsonl
.claude/geolocate_review*.json
.claude/geolocate_review*.md
.claude/geolocate_fill_changes_*.csv
.claude/location_comments_*.csv
.claude/location_comments_*.jsonl
.claude/far_pins_*.csv
.claude/review_flags_*.csv
.claude/dashboard_orphans_*.csv
.claude/aviso_equipo_*.xlsx

# Los dictámenes que consume `--fill --verdicts` sí se versionan: son
# trabajo humano, no salida regenerable
!.claude/verdicts/
!.claude/verdicts/*.csv

# Análisis de los diagnósticos: traen nombres del equipo y el repo es
# público
.claude/*_analisis.md

# Salida regenerable de resolve_legacy_names --project-only
.claude/legacy_names_verdicts_project.csv
