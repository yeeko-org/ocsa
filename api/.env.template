POSTRGRESQL_DB=postgres
DATABASE_NAME=ocs
DATABASE_USER=ocs_user
DATABASE_PASSWORD=ocs_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_SCHEMA=new_schema

POSTRGRESQL_LEGACY_DB=postgres
DATABASE_LEGACY_NAME=ocs
DATABASE_LEGACY_USER=ocs_user
DATABASE_LEGACY_PASSWORD=ocs_password
DATABASE_LEGACY_HOST=localhost
DATABASE_LEGACY_PORT=5432
DATABASE_LEGACY_SCHEMA=old_schema
OPENAI_API_KEY=sk-
GEMINI_API_KEY=

# Motor de Gemini para clasificación y pre-captura. El default de
# settings es la versión estable; ponerlo aquí solo para probar otra.
GEMINI_ENGINE=gemini-3.5-flash-lite

PRESSREADER_USER=correo@example.com
PRESSREADER_PASS=password

IS_LOCAL=True

# --- Archivos de NoteFile/ProjectFile en S3 (solo producción) ---
# Con USE_S3_FILES=0 (default) se usa el disco local (MEDIA_ROOT).
# En producción: USE_S3_FILES=1 + credenciales. Los objetos se suben
# con clase INTELLIGENT_TIERING y son públicos vía bucket policy
# sobre el prefijo AWS_LOCATION.
USE_S3_FILES=0
AWS_STORAGE_BUCKET_NAME=ocsa-docs-032892915740-us-west-2-an
AWS_S3_REGION_NAME=us-west-2
AWS_LOCATION=data_files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Base remota de archivos legados. Solo se usa en local para descargar
# PDF viejos de NoteFile que no están en disco local. Se concatena con
# file.name, por eso incluye el prefijo data_files.
LEGACY_FILES_BASE_URL=https://ocsa-docs-032892915740-us-west-2-an.s3.us-west-2.amazonaws.com/data_files
